# the v3 email API (https://dashboard-v3.provider.com)
EMAIL_API_KEY=your-api-key
EMAIL_API_CLIENT_ID=your-provider-client-id
# US region by default; use https://api.eu.provider.com for EU apps
EMAIL_API_URI=https://api.us.provider.com

# LLM — set ONE of these (Claude Sonnet 4.6 either way):
# Anthropic direct (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...
# ...or OpenRouter (https://openrouter.ai), model anthropic/claude-sonnet-4.6
# OPENROUTER_API_KEY=sk-or-v1-...

# OAuth callback — must be registered in the email API dashboard
CALLBACK_URI=http://localhost:3000/auth/callback
PORT=3000

# Your timezone for proposed meeting slots (IANA name)
USER_TIMEZONE=America/Toronto
